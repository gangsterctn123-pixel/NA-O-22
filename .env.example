# ─────────────────────────────────────────────────────────────
# NAÇÃO 22 — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione credenciais reais.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" ativa o modo demonstração: checkout simulado, dados de exemplo sinalizados
NEXT_PUBLIC_DEMO_MODE=true
# Preço padrão exibido enquanto o banco não responde (centavos). O valor oficial fica em app_settings.
NEXT_PUBLIC_DEFAULT_PRICE_CENTS=499

# Supabase (Fase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (webhooks, pipeline). Nunca expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Fase 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# IA (Fase 4) — provedor configurável
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Pipeline de notícias (Fase 3/4) — protege a rota de cron
CRON_SECRET=

# Push PWA (Fase 8) — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@exemplo.com.br

# Rate limiting distribuído (opcional; sem isso usa memória local)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
